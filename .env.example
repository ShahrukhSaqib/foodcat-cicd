# Copy this file to .env and put your own value in. The real .env is ignored by git.
# SECRET_KEY signs the login tokens. Make a good one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The gateway and the user service must share the same value.
# In the full design this is the job of Vault. Here it is just an environment variable.
SECRET_KEY=change-me-then-delete-this-comment
