# Food Cat on the EC2 server: systemd starts it at boot and restarts it if it stops.
# install_build.sh copies this file to /etc/systemd/system/foodcat.service on every deploy.
[Unit]
Description=Food Cat (the API gateway and the services behind it)
After=network-online.target
Wants=network-online.target

[Service]
User=foodcat
Group=foodcat
WorkingDirectory=/opt/foodcat/current
# The secret key that signs the login tokens. It is made once, on the first deploy, and never leaves the server.
EnvironmentFile=/etc/foodcat/foodcat.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/foodcat/current/.venv/bin/python run_local.py --host 0.0.0.0 --port 80 --data-dir /var/lib/foodcat
# Port 80 is a privileged port. This lets the ordinary foodcat user open it, and gives it nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
SyslogIdentifier=foodcat

[Install]
WantedBy=multi-user.target
